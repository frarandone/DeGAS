/*
Activities:
0)  START
1)  A_SUBMITTED
2)  A_PARTLYSUBMITTED
3)  W_Assess_fraud
4)  W_Fix_incomplete_submission
5)  A_PREACCEPTED
6)  W_Complete_preaccepted_appl
7)  A_ACCEPTED
8)  A_FINALIZED
9)  O_SELECTED
10) O_CREATED
11) O_SENT
12) W_Call_after_offer
13) O_SENT_BACK
14) W_Call_missing_information
15) W_Assess_application
16) O_CANCELLED
17) A_CANCELLED
18) A_DECLINED
19) O_DECLINED
20) O_ACCEPTED
21) A_APPROVED
22) A_REGISTERED
23) A_ACTIVATED
24) END
*/

array[25] tacts;
array[25] endacts;

/* Total time */
t = 0;

/* Activity durations */
tacts[0]  = _mu0  * _mu0  + gm([1], [0.], [0.1]);
tacts[1]  = _mu1  * _mu1  + gm([1], [0.], [1.]);
tacts[2]  = _mu2  * _mu2  + gm([1], [0.], [1.]);
tacts[3]  = _mu3  * _mu3  + gm([1], [0.], [1.]);
tacts[4]  = _mu4  * _mu4  + gm([1], [0.], [1.]);
tacts[5]  = _mu5  * _mu5  + gm([1], [0.], [1.]);
tacts[6]  = _mu6  * _mu6  + gm([1], [0.], [1.]);
tacts[7]  = _mu7  * _mu7  + gm([1], [0.], [1.]);
tacts[8]  = _mu8  * _mu8  + gm([1], [0.], [1.]);
tacts[9]  = _mu9  * _mu9  + gm([1], [0.], [1.]);
tacts[10] = _mu10 * _mu10 + gm([1], [0.], [1.]);
tacts[11] = _mu11 * _mu11 + gm([1], [0.], [1.]);
tacts[12] = _mu12 * _mu12 + gm([1], [0.], [1.]);
tacts[13] = _mu13 * _mu13 + gm([1], [0.], [1.]);
tacts[14] = _mu14 * _mu14 + gm([1], [0.], [1.]);
tacts[15] = _mu15 * _mu15 + gm([1], [0.], [1.]);
tacts[16] = _mu16 * _mu16 + gm([1], [0.], [1.]);
tacts[17] = _mu17 * _mu17 + gm([1], [0.], [1.]);
tacts[18] = _mu18 * _mu18 + gm([1], [0.], [1.]);
tacts[19] = _mu19 * _mu19 + gm([1], [0.], [1.]);
tacts[20] = _mu20 * _mu20 + gm([1], [0.], [1.]);
tacts[21] = _mu21 * _mu21 + gm([1], [0.], [1.]);
tacts[22] = _mu22 * _mu22 + gm([1], [0.], [1.]);
tacts[23] = _mu23 * _mu23 + gm([1], [0.], [1.]);
tacts[24] = _mu24 * _mu24 + gm([1], [0.], [0.1]);

observe(tacts[0]  > 0.);
observe(tacts[1]  > 0.);
observe(tacts[2]  > 0.);
observe(tacts[3]  > 0.);
observe(tacts[4]  > 0.);
observe(tacts[5]  > 0.);
observe(tacts[6]  > 0.);
observe(tacts[7]  > 0.);
observe(tacts[8]  > 0.);
observe(tacts[9]  > 0.);
observe(tacts[10] > 0.);
observe(tacts[11] > 0.);
observe(tacts[12] > 0.);
observe(tacts[13] > 0.);
observe(tacts[14] > 0.);
observe(tacts[15] > 0.);
observe(tacts[16] > 0.);
observe(tacts[17] > 0.);
observe(tacts[18] > 0.);
observe(tacts[19] > 0.);
observe(tacts[20] > 0.);
observe(tacts[21] > 0.);
observe(tacts[22] > 0.);
observe(tacts[23] > 0.);
observe(tacts[24] > 0.);

/* Gateway probabilities */
p0  = _p0  * _p0 ;   /* after A_PARTLYSUBMITTED: go to fraud/fix/preaccepted block */
p1  = _p1  * _p1 ;   /* do W_Assess_fraud */
p2  = _p2  * _p2 ;   /* do W_Fix_incomplete_submission */
p3  = _p3  * _p3 ;   /* do A_PREACCEPTED block */
p4  = _p4  * _p4 ;   /* do A_ACCEPTED */
p5  = _p5  * _p5 ;   /* enter outer parallel block */
p6  = _p6  * _p6;   /* do O_CANCELLED on outer right branch */
p7  = _p7  * _p7;   /* enter inner parallel block with A_FINALIZED and O_SELECTED path */
p8  = _p8  * _p8 ;   /* do A_CANCELLED */
p9  = _p9  * _p9 ;   /* do W_Call_after_offer */
p10 = _p10 * _p10 ;   /* do O_SENT_BACK */
p11 = _p11 * _p11 ;   /* enter inner parallel block with W_Call_missing_information */
p12 = _p12 * _p12 ;   /* do W_Assess_application */
p13 = _p13 * _p13 ;   /* final choice: direct to END */
p14 = _p14 * _p14 ;   /* final choice: A_DECLINED branch vs O_ACCEPTED branch */
p15 = _p15 * _p15 ;   /* after A_DECLINED: do O_DECLINED */

/* START */

endacts[0] = t + tacts[0];
t = endacts[0];

/* A_SUBMITTED */
endacts[1] = t + tacts[1];
t = endacts[1];

/* A_PARTLYSUBMITTED */

endacts[2] = t + tacts[2];
t = endacts[2];

prune(40);

/* After A_PARTLYSUBMITTED:
   - skip to final decision region
   - or go through fraud/fix/preaccepted region
*/
if uniform([0., 1.], 2) - p0 < 0. {

    /* W_Assess_fraud optional */
    if uniform([0., 1.], 2) - p1 < 0. {
        endacts[3] = t + tacts[3];
        t = endacts[3];
    } else {
        skip;
        prune(40);
    } end if;

    prune(40);

    /* W_Fix_incomplete_submission optional */
    if uniform([0., 1.], 2) - p2 < 0. {
        endacts[4] = t + tacts[4];
        t = endacts[4];
    } else {
        skip;
        prune(40);
    } end if;

    prune(40);

    /* A_PREACCEPTED branch optional */
    if uniform([0., 1.], 2) - p3 < 0. {

        endacts[5] = t + tacts[5];
        t = endacts[5];

        endacts[6] = t + tacts[6];
        t = endacts[6];
        prune(40);
        /* A_ACCEPTED optional */
        if uniform([0., 1.], 2) - p4 < 0. {
            endacts[7] = t + tacts[7];
            t = endacts[7];
            prune(40);
        } else {
            skip;
            prune(40);
        } end if;
    prune(40);
    } else {
        skip;
        prune(40);
    } end if;
    prune(40);

} else {
    skip;
    prune(40);
} end if;
prune(40);

/* After this block:
   - either enter outer parallel region
   - or skip it

if uniform([0., 1.], 2) - p5 < 0. {

    /* Outer parallel split */
    branch0 = t;
    branch1 = t;

    /* Left outer branch */
    if uniform([0., 1.], 2) - p7 < 0. {

        /* Inner parallel split:
           branch00 = A_FINALIZED
           branch01 = O_SELECTED path
        */
        branch00 = branch0;
        branch01 = branch0;

        /* branch00: A_FINALIZED */
        endacts[8] = branch00 + tacts[8];
        branch00 = endacts[8];

        /* branch01: O_SELECTED path */
        endacts[9] = branch01 + tacts[9];
        branch01 = endacts[9];

        endacts[10] = branch01 + tacts[10];
        branch01 = endacts[10];

        endacts[11] = branch01 + tacts[11];
        branch01 = endacts[11];

        prune(40);
        
        /* W_Call_after_offer optional */
        if uniform([0., 1.], 2) - p9 < 0. {
            endacts[12] = branch01 + tacts[12];
            branch01 = endacts[12];
            prune(40);
        } else {
            skip;
            prune(40);
        } end if;

        prune(40);

        /* O_SENT_BACK optional */
        if uniform([0., 1.], 2) - p10 < 0. {
            endacts[13] = branch01 + tacts[13];
            branch01 = endacts[13];
            prune(40);
        } else {
            skip;
            prune(40);
        } end if;

        prune(40);

        /* Optional inner parallel with W_Assess_application and W_Call_missing_information */
        if uniform([0., 1.], 2) - p11 < 0. {

            branch10 = branch01;
            branch11 = branch01;

            /* branch10: W_Assess_application optional */
            if uniform([0., 1.], 2) - p12 < 0. {
                endacts[15] = branch10 + tacts[15];
                branch10 = endacts[15];
                prune(40);
            } else {
                skip;
                prune(40);
            } end if;

            prune(40);

            /* branch11: W_Call_missing_information */
            endacts[14] = branch11 + tacts[14];
            branch11 = endacts[14];

            /* Join inner parallel */
            if branch10 - branch11 < 0. {
                branch01 = branch11;
            } else {
                branch01 = branch10;
            } end if;

            prune(40);

        } else {
            skip;
            prune(40);
        } end if;
        prune(40);

        /* Join inner parallel A_FINALIZED || O_SELECTED path */
        if branch00 - branch01 < 0. {
            branch0 = branch01;
        } else {
            branch0 = branch00;
        } end if;

        prune(40);

    } else {
        skip;
    } end if;
    prune(40);

    /* A_CANCELLED optional on left outer branch */
    if uniform([0., 1.], 2) - p8 < 0. {
        endacts[17] = branch0 + tacts[17];
        branch0 = endacts[17];
    } else {
        skip;
    } end if;
    prune(40);

    /* Right outer branch: O_CANCELLED optional */
    if uniform([0., 1.], 2) - p6 < 0. {
        endacts[16] = branch1 + tacts[16];
        branch1 = endacts[16];
    } else {
        skip;
    } end if;
    prune(40);

    /* Join outer parallel */
    if branch0 - branch1 < 0. {
        t = branch1;
    } else {
        t = branch0;
    } end if;

    prune(40);

} else {
    skip;
} end if;

prune(40);    prune(40);

/* Final decision region:
   1) direct to END
   2) A_DECLINED branch
   3) O_ACCEPTED branch
*/
if uniform([0., 1.], 2) - p13 < 0. {

    skip;
    prune(40);

} else {

    if uniform([0., 1.], 2) - p14 < 0. {

        /* A_DECLINED */
        endacts[18] = t + tacts[18];
        t = endacts[18];

        /* O_DECLINED optional */
        if uniform([0., 1.], 2) - p15 < 0. {
            endacts[19] = t + tacts[19];
            t = endacts[19];
        } else {
            skip;
        } end if;

        prune(40);

    } else {

        /* O_ACCEPTED */
        endacts[20] = t + tacts[20];
        t = endacts[20];

        /* A_APPROVED */
        endacts[21] = t + tacts[21];
        t = endacts[21];

        /* A_REGISTERED */
        endacts[22] = t + tacts[22];
        t = endacts[22];

        /* A_ACTIVATED */
        endacts[23] = t + tacts[23];
        t = endacts[23];

        /* prune(40); */

    } end if;

} end if;

/* END */
endacts[24] = t + tacts[24];
t = endacts[24];

