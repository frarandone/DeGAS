
X = -2.0;
/* phi = 0; */
phi = 1;

/* initial value should be calculated explicitly. */

for i in range(30) {

     X = 0.8*X + 0.4 + gauss(0., 0.0484);

     /*
     if X > 2.1 {
          phi = 1;
     } else {
          skip;
     } end if;
     */

     
     if X < 2.1 {
          skip;
     } else {
          phi = 0;
     } end if;
     

} end for;

