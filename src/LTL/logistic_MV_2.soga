currX = 0.8;

counter = 0;

allless10sofar = 1;
OH = 0;

for i in range(30) {

    xSquare = currX * currX;
    noise = gauss(0., 0.0324);
    xNoise = currX * noise;
    newX = 1.32 * currX - 0.032 * xSquare + xNoise;

    currX = newX;
    
    if currX > 10 {
        allless10sofar = 0;
    } else {
        skip;
    } end if;
    
    if counter > 20 {
        if allless10sofar == 1{
            OH = 1;
        } else {
            skip;
        } end if;
    } else {
        skip;
    } end if;


    counter = counter + 1;
} end for;