array[30] X;
phineg = 0;
currX = gm([1.], [_xinit1], [0.01]);

/* Monitor variables for phi3 = O(x > delta) OR O(x < -delta) */
/* phipos = O(x > delta), phineg = O(x < -delta)               */


for i in range(30) {
    X[i] = currX;
    xCube = currX * currX;
    xCube = xCube * currX;
    term = _a * currX - _b * xCube;
    hsq = _h * _h;
    term = hsq * term;
    noise = _h * _sigma;
    noise = noise * gauss(0., 1.);
    newX = currX + term + noise;
    currX = newX;


    /* Monitor for O(x < -delta): becomes 1 if x ever goes below -delta */
    if phineg == 1 {
        skip;
    } else {
        if currX < _ndelta {
            phineg = 1;
        } else {
            skip;
        } end if;
    } end if;


} end for;