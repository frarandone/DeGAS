array[30] X;
phi = 0;
currX = gm([1.], [_xinit1], [0.01]);


for i in range(30) {
    X[i] = currX;
    xCube = currX * currX;
    xCube = xCube * currX;
    term = _a * currX - _b * xCube;
    hsq = _h * _h;
    term = hsq * term;
    noise = _h * _sigma;
    noise = noise * gauss(0., 1.);
    newX = currX + term + noise;
    currX = newX;

} end for;